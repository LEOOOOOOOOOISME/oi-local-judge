{
  "name": "oi-local-judge",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "build:runner": "node tools/build-runner.mjs",
    "bench": "node tools/bench/run-all.mjs",
    "electron:smoke": "electron tools/electron-smoke.cjs",
    "electron:smoke:flags": "electron --no-sandbox --disable-gpu tools/electron-smoke.cjs",
    "electron:start": "electron apps/desktop/dist/main.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
