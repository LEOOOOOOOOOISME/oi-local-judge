{
  "name": "oi-local-judge",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:browser": "playwright test tests/e2e/browser.spec.ts tests/e2e/business-flow.spec.ts",
    "typecheck": "tsc -b",
    "build:help": "node tools/build-help-docs.mjs",
    "build:runner": "node tools/build-runner.mjs",
    "build:interact": "node tools/build-interact.mjs",
    "build:native": "node tools/build-runner.mjs && node tools/build-interact.mjs",
    "bench": "node tools/bench/run-all.mjs",
    "bench:compile": "node tools/bench-compile.mjs",
    "bench:concurrency": "tsx tools/bench/concurrency.mjs",
    "bench:online": "tsx tools/bench/online.mjs",
    "seed": "tsx tools/seed/seed.ts",
    "seed:batch": "node tools/seed/make-batch-zip.mjs",
    "seed:batch:multi": "node tools/seed/make-batch-multi-zip.mjs",
    "build": "node tools/build-help-docs.mjs && tsc -p packages/shared/tsconfig.json && tsc -p apps/server/tsconfig.json && tsc -p apps/desktop/tsconfig.json && npm run build --workspace @oij/web",
    "build:portable": "node tools/build-portable.mjs",
    "build:release": "node tools/release/build-release.mjs",
    "release:bump": "node tools/release/bump-version.mjs",
    "start": "node apps/server/dist/cli.js",
    "electron:smoke": "electron tools/electron-smoke.cjs",
    "electron:smoke:flags": "electron --no-sandbox --disable-gpu tools/electron-smoke.cjs",
    "smoke:desktop": "node tools/electron-smoke.mjs",
    "smoke:desktop:dev": "node tools/electron-smoke.mjs --dev",
    "electron:start": "electron apps/desktop/dist/main.js",
    "web:dev": "npm run dev --workspace @oij/web",
    "web:build": "npm run build --workspace @oij/web",
    "web:typecheck": "npm run typecheck --workspace @oij/web"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/sanitize-html": "^2.16.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@fastify/static": "^10.1.8",
    "@types/markdown-it": "^14.2.0",
    "fflate": "^0.8.3",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "markdown-it-texmath": "^1.0.0",
    "sanitize-html": "^2.18.1"
  },
  "version": "1.1.0-rc.6"
}
